classDiagram
direction LR

class ICipher {
  <<interface>>
  +cipher_type: CipherType
  +encrypt(data: bytes) bytes
  +decrypt(ciphertext: bytes) bytes
}

class CipherType {
  <<enumeration>>
  AES
  RSA
  ECC
  CHACHA20
}

class CipherBase {
  <<abstract>>
  +cipher_type: CipherType
  +encrypt(data: bytes) bytes
  +decrypt(ciphertext: bytes) bytes
  #_validate_bytes(value, name)$
  #do_encrypt(data)*
  #do_decrypt(ciphertext)*
  #_min_ciphertext_length()* int
}

class AesCipher {
  -_key: bytes
  -_aead: AESGCM
  +__init__(key: bytes)
  +key_size() int
  +generate_nonce() bytes
  #_encrypt_with_nonce(data, nonce) bytes
  #do_encrypt(data)
  #do_decrypt(ciphertext)
  #_min_ciphertext_length() int
}

class RsaCipher {
  -_key_pair
  -_public_key
  -_private_key
  +__init__(key_pair)
  +max_block_size() int
  #do_encrypt(data)
  #do_decrypt(ciphertext)
  #_min_ciphertext_length() int
}

class EccCipher {
  -_key_pair
  -_curve: EllipticCurve
  -_public_key
  -_private_key
  +__init__(key_pair, curve=None)
  +derive_shared_key(private_key, peer_public_key) bytes
  #do_encrypt(data)
  #do_decrypt(ciphertext)
  #_min_ciphertext_length() int
}

class CipherFactory {
  -_symmetric_creators$
  -_asymmetric_creators$
  +create_symmetric(cipher_type, key) ICipher$
  +create_asymmetric(cipher_type, key_pair) ICipher$
  +register_symmetric(cipher_type, creator)$
  +register_asymmetric(cipher_type, creator)$
  +supported_symmetric() tuple$
  +supported_asymmetric() tuple$
}

class EllipticCurve {
  +p: int
